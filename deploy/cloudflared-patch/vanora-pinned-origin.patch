+func vanoraCLI(runAction cli.ActionFunc) *cli.App {
+	run := buildRunCommand()
+	if runAction == nil {
+		runAction = runCommand
+	}
+	run.Action = runAction
+	tunnel := buildTunnelCommand([]*cli.Command{run})
+	tunnel.Action = TunnelCommand
+	return &cli.App{
+		Commands:       []*cli.Command{tunnel},
+		Writer:         io.Discard,
+		ErrWriter:      io.Discard,
+		ExitErrHandler: func(*cli.Context, error) {},
+	}
+}
+
+func TestVanoraCLIRejectsIncompletePinsAndOtherTunnelModes(t *testing.T) {
+	t.Setenv("TUNNEL_TOKEN", "")
+	t.Setenv("TUNNEL_TOKEN_FILE", "")
+	pins := []string{"--vanora-pin-hostname", "relay.example", "--vanora-pin-origin", "127.0.0.1:32123"}
+	for _, test := range []struct {
+		name string
+		args []string
+		want string
+	}{
+		{"hostname only", append(pins[:2:2], "run"), "must be set together"},
+		{"origin only", append(pins[2:4:4], "run"), "must be set together"},
+		{"missing token", append(pins[:4:4], "run"), errVanoraPinTokenRun.Error()},
+		{"credentials file", append(pins[:4:4], "run", "--credentials-file", "not-read.json", "example"), errVanoraPinTokenRun.Error()},
+		{"token file only", append(pins[:4:4], "run", "--token-file", "not-read.txt"), errVanoraPinTokenRun.Error()},
+		{"quick tunnel", append(pins[:4:4], "--url", "http://localhost"), errVanoraPinTokenRun.Error()},
+		{"adhoc tunnel", append(pins[:4:4], "--name", "adhoc", "--hello-world"), errVanoraPinTokenRun.Error()},
+		{"explicitly empty hostname", []string{"--vanora-pin-hostname=", pins[2], pins[3], "run", "--token", "token"}, "literal DNS name"},
+		{"explicitly empty origin", []string{pins[0], pins[1], "--vanora-pin-origin=", "run", "--token", "token"}, "canonical 127.0.0.1"},
+		{"invalid token", append(pins[:4:4], "run", "--token", "not-a-token"), "Provided Tunnel token is not valid"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			err := vanoraCLI(nil).Run(append([]string{"cloudflared", "tunnel"}, test.args...))
+			require.ErrorContains(t, err, test.want)
+			require.NotContains(t, err.Error(), pins[3])
+		})
+	}
+}

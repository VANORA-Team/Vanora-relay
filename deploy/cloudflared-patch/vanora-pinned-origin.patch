+	"github.com/stretchr/testify/require"
+
+	"github.com/cloudflare/cloudflared/config"
+)
+
+func TestVanoraPinnedHTTPTransport(t *testing.T) {
+	var otherHits atomic.Int32
+	serverA := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(serverA.Close)
+	serverB := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		otherHits.Add(1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(serverB.Close)
+	t.Setenv("HTTP_PROXY", serverB.URL)
+	t.Setenv("HTTPS_PROXY", serverB.URL)
+	t.Setenv("NO_PROXY", "")
+
+	pinned := netip.MustParseAddrPort(strings.TrimPrefix(serverA.URL, "http://"))
+	other := netip.MustParseAddrPort(strings.TrimPrefix(serverB.URL, "http://"))
+	port := strconv.Itoa(int(pinned.Port()))
+	rules, err := ParseIngress(&config.Configuration{Ingress: []config.UnvalidatedIngressRule{
+		{Hostname: "relay.example", Service: serverA.URL},
+		{Service: "http_status:404"},
+	}})
+	require.NoError(t, err)
+	log := zerolog.Nop()
+	require.Error(t, rules.PinLoopbackHTTPOrigin(other))
+	require.NoError(t, rules.PinLoopbackHTTPOrigin(pinned))
+	require.Error(t, rules.PinLoopbackHTTPOrigin(pinned))
+	rules.Rules[0].Config.MatchSNIToHost = true
+	require.NoError(t, rules.StartOrigins(&log, t.Context().Done()))
+	service := rules.Rules[0].Service.(*httpService)
+	transport := service.transport
+	t.Cleanup(transport.CloseIdleConnections)
+	require.Nil(t, transport.Proxy)
+	require.Nil(t, transport.TLSClientConfig)
+	require.False(t, service.matchSNIToHost)
+	require.False(t, transport.ForceAttemptHTTP2)
+
+	for _, test := range []struct{ network, address, reason string }{
+		{"tcp", other.String(), "does not match"},
+		{"tcp", "localhost:" + port, "does not match"},
+		{"tcp", "[::ffff:127.0.0.1]:" + port, "does not match"},
+		{"unix", pinned.String(), "only TCP"},
+		{"udp", pinned.String(), "only TCP"},
+	} {
+		conn, err := transport.DialContext(t.Context(), test.network, test.address)
+		require.Nil(t, conn)
+		require.ErrorContains(t, err, test.reason)
+		require.NotContains(t, err.Error(), test.address)
+	}
+	conn, err := transport.DialTLSContext(t.Context(), "tcp", pinned.String())
+	require.Nil(t, conn)
+	require.ErrorContains(t, err, "TLS origin dials are disabled")
+	for _, network := range []string{"tcp", "tcp4"} {
+		conn, err := transport.DialContext(t.Context(), network, pinned.String())
+		require.NoError(t, err)
+		require.NoError(t, conn.Close())
+	}
+	req, err := http.NewRequestWithContext(t.Context(), http.MethodGet, "http://relay.example", nil)
+	require.NoError(t, err)
+	resp, err := service.RoundTrip(req)
+	require.NoError(t, err)
+	require.Equal(t, http.StatusNoContent, resp.StatusCode)
+	require.NoError(t, resp.Body.Close())
+	require.Zero(t, otherHits.Load())
+}
+
+func TestVanoraPinLoopbackHTTPOriginRejectsInvalidRules(t *testing.T) {
+	t.Parallel()
+	pinned := netip.MustParseAddrPort("127.0.0.1:12345")
+	rules := Ingress{}
+	require.Error(t, rules.PinLoopbackHTTPOrigin(pinned))
+	rules.Rules = []Rule{{Service: &httpService{}}}
+	require.Error(t, rules.PinLoopbackHTTPOrigin(pinned))
+	log := zerolog.Nop()
+	_, err := newHTTPTransport(&httpService{pinnedOrigin: pinned}, OriginRequestConfig{}, &log)
+	require.ErrorContains(t, err, "requires HTTP")
+
+	for _, service := range []string{"https://" + pinned.String(), "unix:/origin.sock", "http_status:404"} {
+		rules, err := ParseIngress(&config.Configuration{Ingress: []config.UnvalidatedIngressRule{{Service: service}}})
+		require.NoError(t, err)
+		require.Error(t, rules.PinLoopbackHTTPOrigin(pinned))
+	}
+	configured, err := ParseIngress(&config.Configuration{Ingress: []config.UnvalidatedIngressRule{{Service: "http://" + pinned.String()}}})
+	require.NoError(t, err)
+	for _, address := range []string{"127.0.0.1:0", "127.0.0.2:12345", "[::1%test]:12345"} {
+		require.Error(t, configured.PinLoopbackHTTPOrigin(netip.MustParseAddrPort(address)))
+	}
+	require.NoError(t, configured.StartOrigins(&log, t.Context().Done()))
+	require.ErrorContains(t, configured.PinLoopbackHTTPOrigin(pinned), "before it starts")
+}
+
+func TestVanoraPinnedIPv6HTTPDial(t *testing.T) {
+	t.Parallel()
+	listener, err := net.Listen("tcp6", "[::1]:0")
+	if err != nil {
+		t.Skipf("IPv6 loopback unavailable: %v", err)
+	}
+	t.Cleanup(func() { _ = listener.Close() })
+
+	pinned := listener.Addr().(*net.TCPAddr).AddrPort()
+	rules, err := ParseIngress(&config.Configuration{Ingress: []config.UnvalidatedIngressRule{{Service: "http://" + pinned.String()}}})
+	require.NoError(t, err)
+	require.NoError(t, rules.PinLoopbackHTTPOrigin(pinned))
+	log := zerolog.Nop()
+	require.NoError(t, rules.StartOrigins(&log, t.Context().Done()))
+	transport := rules.Rules[0].Service.(*httpService).transport
+	conn, err := transport.DialContext(t.Context(), "tcp6", pinned.String())
+	require.NoError(t, err)
+	require.NoError(t, conn.Close())
+}
+
+func TestVanoraBlocksPrivateAndReservedDials(t *testing.T) {
+	t.Parallel()
+	log := zerolog.Nop()
+	dialer := NewOriginDialer(OriginConfig{BlockPrivateNetwork: true}, &log)
+	virtualDNS := netip.MustParseAddrPort("[2606:4700:cf1:2000::1]:53")
+	dialer.AddReservedService(nil, []netip.AddrPort{virtualDNS})
+	addresses := []netip.AddrPort{
+		netip.MustParseAddrPort("192.168.1.1:80"),
+		netip.MustParseAddrPort("127.0.0.1:12345"),
+		netip.MustParseAddrPort("1.1.1.1:443"),
+		virtualDNS,
+	}
+	assertBlocked := func() {
+		for _, address := range addresses {
+			conn, err := dialer.DialTCP(t.Context(), address)
+			require.Nil(t, conn)
+			require.ErrorIs(t, err, errPrivateNetworkBlocked)
+			conn, err = dialer.DialUDP(address)
+			require.Nil(t, conn)
+			require.ErrorIs(t, err, errPrivateNetworkBlocked)
+		}
+	}
+	assertBlocked()
+	dialer.UpdateDefaultDialer(NewDialer(WarpRoutingConfig{}))
+	assertBlocked()
+}
+
+func TestVanoraPinnedNetworkErrorOmitsAddresses(t *testing.T) {
+	t.Parallel()
+	source := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 54213}
+	target := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 65123}
+	err := redactPinnedNetworkError(&net.OpError{Op: "read", Net: "tcp", Source: source, Addr: target, Err: io.ErrUnexpectedEOF})
+	require.ErrorIs(t, err, io.ErrUnexpectedEOF)
+	require.NotContains(t, err.Error(), source.String())
+	require.NotContains(t, err.Error(), target.String())
+}

+func testVanoraQUICEdge(t *testing.T, orch *Orchestrator, dialer *ingress.OriginDialerService,
+	certificates []tls.Certificate, cert *x509.Certificate, hostname, matching, drift string,
+) {
+	t.Helper()
+	const alpn = "vanora-test"
+	const timeout = 5 * time.Second
+	ctx, cancel := context.WithTimeout(t.Context(), timeout)
+	defer cancel()
+	quicConfig := &quic.Config{EnableDatagrams: true}
+	listener, err := quic.ListenAddr("127.0.0.1:0", &tls.Config{Certificates: certificates, NextProtos: []string{alpn}}, quicConfig)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = listener.Close() })
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+	log := zerolog.Nop()
+	conn, err := connection.DialQuic(ctx, quicConfig, &tls.Config{
+		ServerName: "example.com", RootCAs: roots, NextProtos: []string{alpn},
+	}, netip.MustParseAddrPort(listener.Addr().String()), net.IPv4(127, 0, 0, 1), 0, &log, dialopts.DialOpts{SkipPortReuse: true})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = conn.CloseWithError(0, "") })
+	edge, err := listener.Accept(ctx)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = edge.CloseWithError(0, "") })
+
+	datagrams := connection.NewDatagramV2Connection(ctx, conn, dialer, nil, 0, timeout, timeout, orch.GetFlowLimiter(), &log)
+	tunnel := connection.NewTunnelConnection(ctx, conn, 0, orch, datagrams, vanoraTestControlStream{},
+		&client.ConnectionOptionsSnapshot{}, timeout, timeout, 0, &log)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_ = tunnel.Serve(ctx)
+	}()
+	defer func() {
+		cancel()
+		<-done
+	}()
+
+	rpcStream, err := edge.OpenStreamSync(ctx)
+	require.NoError(t, err)
+	cfdStream := cfdquic.NewSafeStreamCloser(rpcStream, timeout, &log)
+	rpc, err := rpcquic.NewCloudflaredClient(ctx, cfdStream, timeout)
+	require.NoError(t, err)
+	defer rpc.Close()
+	lastVersion := orch.currentVersion
+	response, err := rpc.UpdateConfiguration(ctx, lastVersion+1, []byte(drift))
+	require.NoError(t, err)
+	require.Error(t, response.Err)
+	require.Equal(t, lastVersion, response.LastAppliedVersion)
+	response, err = rpc.UpdateConfiguration(ctx, lastVersion+1, []byte(matching))
+	require.NoError(t, err)
+	require.NoError(t, response.Err)
+	require.Equal(t, lastVersion+1, response.LastAppliedVersion)
+
+	openStream := func() *rpcquic.RequestClientStream {
+		stream, err := edge.OpenStreamSync(ctx)
+		require.NoError(t, err)
+		require.NoError(t, stream.SetDeadline(time.Now().Add(timeout)))
+		safeStream := cfdquic.NewSafeStreamCloser(stream, timeout, &log)
+		t.Cleanup(func() { _ = safeStream.Close() })
+		return &rpcquic.RequestClientStream{ReadWriteCloser: safeStream}
+	}
+	for _, test := range []struct{ host, status string }{
+		{strings.ToUpper(hostname), "204"},
+		{"unmatched.example", "404"},
+		{"management.argotunnel.com", "404"},
+	} {
+		stream := openStream()
+		require.NoError(t, stream.WriteConnectRequestData("https://"+test.host+"/relay", pogs.ConnectionTypeHTTP,
+			pogs.Metadata{Key: connection.HTTPHostKey, Val: test.host},
+			pogs.Metadata{Key: connection.HTTPMethodKey, Val: http.MethodGet}))
+		result, err := stream.ReadConnectResponseData()
+		require.NoError(t, err)
+		require.Empty(t, result.Error)
+		require.Contains(t, result.Metadata, pogs.Metadata{Key: connection.HTTPStatus, Val: test.status})
+		if test.status == "204" {
+			require.Contains(t, result.Metadata, pogs.Metadata{Key: "HttpHeader:X-Observed-Host", Val: hostname})
+		}
+	}
+
+	ws := openStream()
+	require.NoError(t, ws.WriteConnectRequestData("https://"+hostname+"/relay", pogs.ConnectionTypeWebsocket,
+		pogs.Metadata{Key: connection.HTTPHostKey, Val: hostname},
+		pogs.Metadata{Key: connection.HTTPMethodKey, Val: http.MethodGet},
+		pogs.Metadata{Key: "HttpHeader:Sec-WebSocket-Key", Val: "dGhlIHNhbXBsZSBub25jZQ=="}))
+	result, err := ws.ReadConnectResponseData()
+	require.NoError(t, err)
+	require.Empty(t, result.Error)
+	require.Contains(t, result.Metadata, pogs.Metadata{Key: connection.HTTPStatus, Val: "101"})
+	require.Contains(t, result.Metadata, pogs.Metadata{Key: "HttpHeader:X-Observed-Host", Val: hostname})
+	require.NoError(t, wsutil.WriteClientText(ws, []byte("vanora QUIC echo")))
+	echo, err := wsutil.ReadServerText(ws)
+	require.NoError(t, err)
+	require.Equal(t, "vanora QUIC echo", string(echo))
+
+	virtualDNS := origins.VirtualDNSServiceAddr
+	tcp := openStream()
+	require.NoError(t, tcp.WriteConnectRequestData("192.168.1.20:5151", pogs.ConnectionTypeTCP))
+	result, err = tcp.ReadConnectResponseData()
+	require.NoError(t, err)
+	require.Contains(t, result.Error, "private network origin dialing is disabled")
+	for _, addr := range []netip.AddrPort{netip.MustParseAddrPort("192.168.1.20:5151"), virtualDNS} {
+		udp, err := rpc.RegisterUdpSession(ctx, uuid.New(), net.IP(addr.Addr().AsSlice()), addr.Port(), time.Second, "")
+		require.NoError(t, err)
+		require.ErrorContains(t, udp.Err, "private network origin dialing is disabled")
+	}
+
+	echoRequest, err := packet.NewEncoder().Encode(&packet.ICMP{
+		IP: &packet.IP{
+			Src: netip.MustParseAddr("192.0.2.1"), Dst: netip.MustParseAddr("127.0.0.1"),
+			Protocol: layers.IPProtocolICMPv4, TTL: 1,
+		},
+		Message: &icmp.Message{Type: ipv4.ICMPTypeEcho, Body: &icmp.Echo{ID: 1, Seq: 1}},
+	})
+	require.NoError(t, err)
+	raw, err := cfdquic.SuffixType(echoRequest.Data, cfdquic.DatagramTypeIP)
+	require.NoError(t, err)
+	require.NoError(t, edge.SendDatagram(raw))
+	datagramCtx, cancelDatagram := context.WithTimeout(ctx, 200*time.Millisecond)
+	defer cancelDatagram()
+	_, err = edge.ReceiveDatagram(datagramCtx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+}

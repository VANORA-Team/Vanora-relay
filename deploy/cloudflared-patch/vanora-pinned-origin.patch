new file mode 100644
index 0000000..68ab18d
--- /dev/null
+++ b/orchestration/vanora_pin.go
@@ -0,0 +1,128 @@
+package orchestration
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/netip"
+	"slices"
+	"strings"
+	"unicode/utf8"
+)
+
+const maxPinnedConfigSize = 64 * 1024
+
+// VanoraPin specifies the process-local hostname and origin of a restricted tunnel.
+type VanoraPin struct {
+	Hostname string
+	Origin   netip.AddrPort
+}
+
+// Active reports whether this tunnel started with a pin.
+func (pin VanoraPin) Active() bool {
+	return pin.Origin.IsValid()
+}
+
+// Service returns the canonical HTTP service URL for the pinned origin.
+func (pin VanoraPin) Service() string {
+	return "http://" + pin.Origin.String()
+}
+
+func (pin VanoraPin) validateRemoteConfig(raw []byte) error {
+	if len(raw) > maxPinnedConfigSize {
+		return errors.New("pinned configuration exceeds size limit")
+	}
+	top, ok := pinnedObject(raw, "ingress", "warp-routing", "originRequest")
+	if !ok || !utf8.Valid(raw) {
+		return errors.New("invalid pinned configuration object")
+	}
+	if !emptyPinnedObject(top["originRequest"]) {
+		return errors.New("global originRequest must be empty")
+	}
+	if warp := top["warp-routing"]; !omittedOrNull(warp) {
+		warpFields, ok := pinnedObject(warp, "enabled")
+		if !ok || (len(warpFields) != 0 && !bytes.Equal(warpFields["enabled"], []byte("false"))) {
+			return errors.New("warp-routing must be disabled")
+		}
+	}
+
+	var rules []json.RawMessage
+	if err := json.Unmarshal(top["ingress"], &rules); err != nil || len(rules) != 2 {
+		return errors.New("pinned configuration requires exactly two ingress rules")
+	}
+	first, ok := pinnedObject(rules[0], "hostname", "service", "path", "originRequest")
+	if !ok || !pin.matchesHostname(first["hostname"]) ||
+		!matchesPinnedString(first["service"], pin.Service()) || !emptyPinnedString(first["path"]) {
+		return errors.New("first ingress rule must match the pinned hostname and service with no path")
+	}
+	if options := first["originRequest"]; !omittedOrNull(options) {
+		fields, ok := pinnedObject(options, "httpHostHeader")
+		if !ok || (len(fields) != 0 && !pin.matchesHostname(fields["httpHostHeader"])) {
+			return errors.New("first ingress rule may only set the pinned HTTP host header")
+		}
+	}
+	catchAll, ok := pinnedObject(rules[1], "hostname", "service", "path", "originRequest")
+	if !ok || !matchesPinnedString(catchAll["service"], "http_status:404") ||
+		!emptyPinnedString(catchAll["hostname"]) || !emptyPinnedString(catchAll["path"]) ||
+		!emptyPinnedObject(catchAll["originRequest"]) {
+		return errors.New("second ingress rule must be an unconditional HTTP 404")
+	}
+	return nil
+}
+
+func pinnedObject(raw json.RawMessage, allowed ...string) (map[string]json.RawMessage, bool) {
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	first, err := decoder.Token()
+	if err != nil || first != json.Delim('{') {
+		return nil, false
+	}
+	fields := make(map[string]json.RawMessage, len(allowed))
+	for decoder.More() {
+		token, err := decoder.Token()
+		key, ok := token.(string)
+		if err != nil || !ok || !slices.Contains(allowed, key) {
+			return nil, false
+		}
+		if _, duplicate := fields[key]; duplicate {
+			return nil, false
+		}
+		var value json.RawMessage
+		if err := decoder.Decode(&value); err != nil {
+			return nil, false
+		}
+		fields[key] = value
+	}
+	last, err := decoder.Token()
+	if err != nil || last != json.Delim('}') {
+		return nil, false
+	}
+	_, err = decoder.Token()
+	return fields, err == io.EOF
+}
+
+func omittedOrNull(raw json.RawMessage) bool {
+	return len(raw) == 0 || bytes.Equal(raw, []byte("null"))
+}
+
+func emptyPinnedObject(raw json.RawMessage) bool {
+	if omittedOrNull(raw) {
+		return true
+	}
+	_, ok := pinnedObject(raw)
+	return ok
+}
+
+func emptyPinnedString(raw json.RawMessage) bool {
+	return len(raw) == 0 || bytes.Equal(raw, []byte(`""`))
+}
+
+func matchesPinnedString(raw json.RawMessage, expected string) bool {
+	var value string
+	return len(raw) != 0 && raw[0] == '"' && json.Unmarshal(raw, &value) == nil && value == expected
+}
+
+func (pin VanoraPin) matchesHostname(raw json.RawMessage) bool {
+	var value string
+	return json.Unmarshal(raw, &value) == nil && len(value) == len(pin.Hostname) && strings.EqualFold(value, pin.Hostname)
+}

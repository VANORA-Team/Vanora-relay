+func TestVanoraPinnedOriginIntegration(t *testing.T) {
+	const hostname = "relay.example"
+	var hitsA, hitsB atomic.Int32
+	serverA := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hitsA.Add(1)
+		w.Header().Set("X-Observed-Host", r.Host)
+		if r.Host != hostname {
+			w.WriteHeader(http.StatusMisdirectedRequest)
+			return
+		}
+		if !gows.IsWebSocketUpgrade(r) {
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		upgrader := gows.Upgrader{}
+		conn, err := upgrader.Upgrade(w, r, w.Header())
+		if err != nil {
+			return
+		}
+		defer func() { _ = conn.Close() }()
+		messageType, message, err := conn.ReadMessage()
+		if err == nil {
+			_ = conn.WriteMessage(messageType, message)
+		}
+	}))
+	t.Cleanup(serverA.Close)
+	serverB := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		hitsB.Add(1)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(serverB.Close)
+
+	var output bytes.Buffer
+	log := zerolog.New(zerolog.SyncWriter(&output)).Level(zerolog.DebugLevel)
+	pin := VanoraPin{Hostname: hostname, Origin: netip.MustParseAddrPort(serverA.Listener.Addr().String())}
+	orch, initialConfig := newVanoraTestOrchestrator(t, pin, &log)
+	initialProxy, err := orch.GetOriginProxy()
+	require.NoError(t, err)
+	initialShutdown := orch.proxyShutdownC
+	edge := connection.NewHTTP2Connection(nil, orch, nil, connection.NewObserver(&log), 0, nil, &log)
+	http2Edge := httptest.NewUnstartedServer(edge)
+	http2Edge.EnableHTTP2 = true
+	http2Edge.StartTLS()
+	t.Cleanup(http2Edge.Close)
+
+	request := func(host string, status int) {
+		req, err := http.NewRequestWithContext(t.Context(), http.MethodGet, http2Edge.URL+"/unfiltered/path", nil)
+		require.NoError(t, err)
+		req.Host = host
+		response, err := http2Edge.Client().Do(req)
+		require.NoError(t, err)
+		require.NoError(t, response.Body.Close())
+		require.Equal(t, 2, response.ProtoMajor)
+		require.Equal(t, status, response.StatusCode)
+		if status == http.StatusNoContent {
+			checkVanoraHostHeader(t, response.Header, hostname)
+		}
+	}
+	require.Equal(t, int32(-1), orch.currentVersion)
+	request(strings.ToUpper(hostname), http.StatusNoContent)
+	request("unmatched.example", http.StatusNotFound)
+	request("management.argotunnel.com", http.StatusNotFound)
+	require.EqualValues(t, 1, hitsA.Load())
+	require.Zero(t, hitsB.Load())
+
+	for _, addr := range []netip.AddrPort{pin.Origin, origins.VirtualDNSServiceAddr} {
+		_, err := initialConfig.OriginDialerService.DialTCP(t.Context(), addr)
+		require.ErrorContains(t, err, "private network origin dialing is disabled")
+		_, err = initialConfig.OriginDialerService.DialUDP(addr)
+		require.ErrorContains(t, err, "private network origin dialing is disabled")
+	}
+	initialConfig.VanoraPin = VanoraPin{}
+	named := fmt.Sprintf(`{"hostname":"%s","service":"%s"}`, hostname, pin.Service())
+	catchAll := `{"service":"http_status:404"}`
+	withOptions := strings.TrimSuffix(named, "}")
+	minimal := `{"ingress":[` + named + `,` + catchAll + `]}`
+	relayPayload := `{"ingress":[` + named + `,` + catchAll + `],"warp-routing":{"enabled":false}}`
+	rejected := orch.UpdateConfig(0, []byte(`{"ingress":[]}`))

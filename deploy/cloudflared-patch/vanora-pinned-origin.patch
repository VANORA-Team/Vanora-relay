+		{"per-rule override", `{"ingress":[` + withOptions + `,"originRequest":{"noTLSVerify":true}},` + catchAll + `]}`},
+		{"wrong host header", `{"ingress":[` + withOptions + `,"originRequest":{"httpHostHeader":"other.example"}},` + catchAll + `]}`},
+		{"null host header", `{"ingress":[` + withOptions + `,"originRequest":{"httpHostHeader":null}},` + catchAll + `]}`},
+		{"extra named rule key", `{"ingress":[` + withOptions + `,"unknown":true},` + catchAll + `]}`},

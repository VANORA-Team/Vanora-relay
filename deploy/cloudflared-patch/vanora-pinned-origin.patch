diff --git a/cmd/cloudflared/tunnel/vanora_pin.go b/cmd/cloudflared/tunnel/vanora_pin.go
new file mode 100644
index 0000000..dd6056f
--- /dev/null
+++ b/cmd/cloudflared/tunnel/vanora_pin.go
@@ -0,0 +1,64 @@
+package tunnel
+
+import (
+	"errors"
+	"net/netip"
+	"strings"
+
+	"github.com/urfave/cli/v2"
+
+	"github.com/cloudflare/cloudflared/orchestration"
+)
+
+const (
+	vanoraPinHostnameFlag = "vanora-pin-hostname"
+	vanoraPinOriginFlag   = "vanora-pin-origin"
+)
+
+var errVanoraPinTokenRun = errors.New("Vanora pins require a Named Tunnel started with tunnel run and --token or TUNNEL_TOKEN")
+
+func readVanoraPin(c *cli.Context, tokenRun bool) (orchestration.VanoraPin, error) {
+	var pin orchestration.VanoraPin
+	hostSet, originSet := c.IsSet(vanoraPinHostnameFlag), c.IsSet(vanoraPinOriginFlag)
+	if !hostSet && !originSet {
+		return pin, nil
+	}
+	if !hostSet || !originSet {
+		return pin, errors.New("--vanora-pin-hostname and --vanora-pin-origin must be set together")
+	}
+	if !tokenRun {
+		return pin, errVanoraPinTokenRun
+	}
+
+	hostname := c.String(vanoraPinHostnameFlag)
+	if !validVanoraHostname(hostname) {
+		return pin, errors.New("--vanora-pin-hostname must be a literal DNS name")
+	}
+	rawOrigin := c.String(vanoraPinOriginFlag)
+	origin, err := netip.ParseAddrPort(rawOrigin)
+	if err != nil || origin.Port() == 0 || origin.String() != rawOrigin ||
+		(origin.Addr() != netip.AddrFrom4([4]byte{127, 0, 0, 1}) && origin.Addr() != netip.IPv6Loopback()) {
+		return pin, errors.New("--vanora-pin-origin must be canonical 127.0.0.1:<port> or [::1]:<port> with a nonzero port")
+	}
+	return orchestration.VanoraPin{Hostname: hostname, Origin: origin}, nil
+}
+
+func validVanoraHostname(hostname string) bool {
+	if len(hostname) > 253 {
+		return false
+	}
+	if _, err := netip.ParseAddr(hostname); err == nil {
+		return false
+	}
+	for label := range strings.SplitSeq(hostname, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for _, char := range label {
+			if !(char >= 'a' && char <= 'z' || char >= 'A' && char <= 'Z' || char >= '0' && char <= '9' || char == '-') {
+				return false
+			}
+		}
+	}
+	return true
+}

+func testVanoraWebsocket(t *testing.T, edge *connection.HTTP2Connection, hostname string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	reqReader, reqWriter := io.Pipe()
+	defer func() { _ = reqWriter.Close() }()
+	respReader, respWriter := io.Pipe()
+	defer func() { _ = respReader.Close() }()
+	edgeWriter := &respReadWriteFlusher{Reader: respReader, w: respWriter, headers: make(http.Header), hasStatus: make(chan struct{})}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://"+hostname+"/relay", reqReader)
+	require.NoError(t, err)
+	req.Header.Set(connection.InternalUpgradeHeader, connection.WebsocketUpgrade)
+	req.Header.Set("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		defer func() { _ = respWriter.Close() }()
+		edge.ServeHTTP(edgeWriter, req)
+	}()
+	stop := context.AfterFunc(ctx, func() {
+		_ = reqWriter.CloseWithError(ctx.Err())
+		_ = respWriter.CloseWithError(ctx.Err())
+	})
+	defer stop()
+	select {
+	case <-edgeWriter.hasStatus:
+	case <-ctx.Done():
+		t.Fatal("websocket upgrade timed out")
+	}
+	require.Equal(t, http.StatusOK, edgeWriter.statusCode)
+	checkVanoraHostHeader(t, edgeWriter.Header(), hostname)
+	require.NoError(t, wsutil.WriteClientText(reqWriter, []byte("vanora pinned echo")))
+	echo, err := wsutil.ReadServerText(edgeWriter)
+	require.NoError(t, err)
+	require.Equal(t, "vanora pinned echo", string(echo))
+	require.NoError(t, reqWriter.Close())
+	select {
+	case <-done:
+	case <-ctx.Done():
+		t.Fatal("websocket proxy did not close")
+	}
+}
+
+func checkVanoraHostHeader(t *testing.T, headers http.Header, hostname string) {
+	t.Helper()
+	decoded, err := connection.DeserializeHeaders(headers.Get(connection.CanonicalResponseUserHeaders))
+	require.NoError(t, err)
+	require.Contains(t, decoded, connection.HTTPHeader{Name: "X-Observed-Host", Value: hostname})
+}

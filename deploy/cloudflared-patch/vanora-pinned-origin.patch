+// PinLoopbackHTTPOrigin locks the first ingress rule's HTTP dialer before origins start.
+func (ing *Ingress) PinLoopbackHTTPOrigin(origin netip.AddrPort) error {
+	if origin.Port() == 0 ||
+		(origin.Addr() != netip.AddrFrom4([4]byte{127, 0, 0, 1}) && origin.Addr() != netip.IPv6Loopback()) {
+		return errors.New("pinned HTTP origin must be a loopback address with a nonzero port")
+	}
+	if len(ing.Rules) == 0 {
+		return errors.New("pinned HTTP origin requires an ingress rule")
+	}
+	service, ok := ing.Rules[0].Service.(*httpService)
+	if !ok || service == nil || service.url == nil || service.url.Scheme != "http" || service.url.Host != origin.String() {
+		return errors.New("first ingress rule must use the pinned loopback HTTP origin")
+	}
+	if service.transport != nil || service.pinnedOrigin.IsValid() {
+		return errors.New("HTTP origin must be pinned once before it starts")
+	}
+	service.pinnedOrigin = origin
+	return nil
+}

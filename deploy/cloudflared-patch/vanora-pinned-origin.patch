+		{"catch-all path", strings.ReplaceAll(minimal, catchAll, `{"service":"http_status:404","path":"^/"}`)},
+		{"catch-all service", strings.ReplaceAll(minimal, "http_status:404", "http_status:503")},
+		{"catch-all override", strings.ReplaceAll(minimal, catchAll, `{"service":"http_status:404","originRequest":{"httpHostHeader":"relay.example"}}`)},
+		{"catch-all extra key", strings.ReplaceAll(minimal, catchAll, `{"service":"http_status:404","unknown":0}`)},
+		{"duplicate ingress", `{"ingress":[],` + minimal[1:]},
+		{"escaped duplicate ingress", `{"\u0069ngress":[],` + minimal[1:]},
+		{"duplicate service", `{"ingress":[` + withOptions + `,"service":"` + pin.Service() + `"},` + catchAll + `]}`},
+		{"duplicate warp key", strings.ReplaceAll(relayPayload, `"enabled":false`, `"enabled":false,"enabled":false`)},
+		{"duplicate origin key", `{"ingress":[` + withOptions + `,"originRequest":{"httpHostHeader":"relay.example","httpHostHeader":"relay.example"}},` + catchAll + `]}`},
+		{"trailing object", minimal + `{}`},
+		{"trailing scalar", minimal + ` null`},
+		{"truncated config", minimal[:len(minimal)-1]},
+		{"unknown top-level key", `{"probe":"raw-config-must-not-log",` + minimal[1:]},
+		{"case-variant top-level key", strings.ReplaceAll(minimal, "ingress", "Ingress")},
+		{"oversize", strings.Repeat(" ", maxPinnedConfigSize) + minimal},
+	}
+	for _, drift := range drifts {

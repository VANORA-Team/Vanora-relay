+func newVanoraTestOrchestrator(t *testing.T, pin VanoraPin, log *zerolog.Logger) (*Orchestrator, *Config) {
+	t.Helper()
+	rules, err := ingress.ParseIngress(&config.Configuration{Ingress: []config.UnvalidatedIngressRule{
+		{Hostname: pin.Hostname, Service: pin.Service(), OriginRequest: config.OriginRequestConfig{HTTPHostHeader: &pin.Hostname}},
+		{Service: "http_status:404"},
+	}})
+	require.NoError(t, err)
+	require.NoError(t, rules.PinLoopbackHTTPOrigin(pin.Origin))
+	compiled := &Config{
+		Ingress:             &rules,
+		VanoraPin:           pin,
+		OriginDialerService: ingress.NewOriginDialer(ingress.OriginConfig{BlockPrivateNetwork: true}, log),
+	}
+	orch, err := NewOrchestrator(t.Context(), compiled, nil, nil, log)
